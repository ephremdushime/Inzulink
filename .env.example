# InzuLink backend environment — copy to .env and fill in. NEVER commit .env.
PORT=3000

# Neon Postgres connection string (rotate in Neon console if ever exposed)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Comma-separated allowed frontend origins for CORS (empty = allow all, dev only)
CORS_ORIGIN=https://your-frontend.onrender.com

# Public frontend base URL (used for password-reset links)
FRONTEND_URL=https://your-frontend.onrender.com

# Gmail sender for password resets (use a Google App Password, not your login)
EMAIL_USER=you@gmail.com
EMAIL_APP_PASS=

# Shared secret guarding POST /api/auth/seed-admin (long random string)
ADMIN_SEED_SECRET=
